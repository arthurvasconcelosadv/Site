# ===================================================
# .htaccess — Advogado Trabalhista
# Compatível com Hostinger, Locaweb, Hostgator, UOL
# ===================================================

Options -Indexes

# ─── CHARSET ───────────────────────────────────────
AddDefaultCharset UTF-8

# ─── ERROS PERSONALIZADOS ──────────────────────────
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

# ─── HTTPS FORÇADO ────────────────────────────────
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ─── WWW → SEM WWW ────────────────────────────────
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# ─── BARRA FINAL → SEM BARRA ──────────────────────
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [R=301,L]

# ─── REDIRECTS AMIGÁVEIS ──────────────────────────
RewriteRule ^insalubridade/?$        /areas/insalubridade.html [R=301,L]
RewriteRule ^rescisao-indireta/?$    /areas/demissao.html      [R=301,L]
RewriteRule ^assedio-moral/?$        /areas/assedio.html       [R=301,L]
RewriteRule ^acidente-trabalho/?$    /areas/acidente.html      [R=301,L]
RewriteRule ^jornada/?$              /areas/jornada.html       [R=301,L]
RewriteRule ^blog/?$                 /blog/index.html          [R=301,L]
RewriteRule ^contato/?$              /contato.html             [R=301,L]
RewriteRule ^sobre/?$                /sobre.html               [R=301,L]
RewriteRule ^uberlandia/?$           /uberlandia.html          [R=301,L]
RewriteRule ^online/?$               /online.html              [R=301,L]
RewriteRule ^atendimento-online/?$   /online.html              [R=301,L]
RewriteRule ^advogado-uberlandia/?$  /uberlandia.html          [R=301,L]

# ─── HEADERS DE SEGURANÇA ─────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options    "nosniff"
  Header always set X-Frame-Options           "DENY"
  Header always set X-XSS-Protection          "1; mode=block"
  Header always set Referrer-Policy           "strict-origin-when-cross-origin"
  Header always set Permissions-Policy        "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# ─── CACHE E COMPRESSÃO ───────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript
  AddOutputFilterByType DEFLATE text/xml application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 month"
  ExpiresByType image/jpeg                "access plus 1 month"
  ExpiresByType image/png                 "access plus 1 month"
  ExpiresByType image/webp                "access plus 1 month"
  ExpiresByType application/json          "access plus 1 day"
  ExpiresByType text/xml                  "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# ─── BLOQUEAR ACESSO A ARQUIVOS SENSÍVEIS ─────────
<FilesMatch "(^\.htaccess|README\.md|netlify\.toml|vercel\.json)$">
  Order Allow,Deny
  Deny from all
</FilesMatch>

# ─── BLOQUEAR BOTS RUINS ──────────────────────────
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP_USER_AGENT} ^$ [OR]
  RewriteCond %{HTTP_USER_AGENT} (ahrefsbot|semrushbot|majestic|dotbot|petalbot) [NC]
  RewriteRule .* - [F,L]
</IfModule>
